@model LMS.Web.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Master New Skills Online";
}

<!-- Hero Section -->
<section class="py-5 my-4">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold mb-3">
                <i class="fa-solid fa-sparkles me-1"></i> #1 Online Learning Platform
            </span>
            <h1 class="display-4 fw-extrabold text-dark tracking-tight mb-3" style="line-height: 1.2;">
                Unlock Your Potential with <span style="background: linear-gradient(135deg, #4f46e5, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">LearnPulse</span>
            </h1>
            <p class="lead text-muted mb-4">
                Access interactive, expert-led courses in technology, business, design, and development. Learn at your own pace from anywhere in the world.
            </p>
            <div class="d-flex flex-wrap gap-3 mb-4">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-lg">
                    <i class="fa-solid fa-rocket me-2"></i> Get Started Free
                </a>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-custom btn-lg">
                    <i class="fa-solid fa-compass me-2"></i> Explore Courses
                </a>
            </div>
            <div class="d-flex align-items-center gap-4 text-muted small pt-3 border-top">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-check text-success"></i> Expert Instructors
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-check text-success"></i> Lifetime Access
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-check text-success"></i> Verified Certificates
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="position-relative">
                @if (Model.FeaturedCourse != null)
                {
                    <div class="card card-custom p-4 border-0 shadow-lg" style="background: linear-gradient(135deg, #1e1b4b, #312e81); color: white;">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white rounded-circle p-3">
                                    <i class="fa-solid fa-laptop-code fa-2xl"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-white">@Model.FeaturedCourse.Title</h5>
                                    <span class="badge bg-success">Top Featured Course</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-white-50 small mb-4">@Model.FeaturedCourse.ShortDescription</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <span class="badge bg-primary-subtle text-white border border-primary-subtle">
                                <i class="@Model.FeaturedCourse.Category?.IconClass me-1"></i> @Model.FeaturedCourse.Category?.Name
                            </span>
                            <span class="h4 fw-bold mb-0 text-white">৳@((Model.FeaturedCourse.DiscountPrice ?? Model.FeaturedCourse.Price).ToString("F2"))</span>
                        </div>

                    </div>
                }
                else
                {
                    <div class="card card-custom p-4 border-0 shadow-lg text-center" style="background: linear-gradient(135deg, #1e1b4b, #312e81); color: white;">
                        <div class="py-4">
                            <i class="fa-solid fa-graduation-cap fa-4x text-primary mb-3"></i>
                            <h4 class="fw-bold text-white mb-2">Welcome to LearnPulse LMS</h4>
                            <p class="text-white-50 small">Explore our wide variety of industry-tailored courses and enhance your skills today.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Dynamic Stats Banner -->
<section class="py-4 my-4">
    <div class="card card-custom p-4 bg-white shadow-sm border">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <div class="h2 fw-bold text-primary mb-0">@Model.TotalCoursesCount</div>
                <div class="text-muted small">Published Courses</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="h2 fw-bold text-primary mb-0">@Model.TotalStudentsCount</div>
                <div class="text-muted small">Registered Platform Users</div>
            </div>

            <div class="col-6 col-md-3">
                <div class="h2 fw-bold text-primary mb-0">@Model.TotalLessonsCount</div>
                <div class="text-muted small">Interactive Video Lessons</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="h2 fw-bold text-primary mb-0">@Model.TotalCategoriesCount</div>
                <div class="text-muted small">Specialized Skill Categories</div>
            </div>
        </div>
    </div>
</section>


<!-- Features Section -->
<section id="features" class="py-5">
    <div class="text-center max-w-2xl mx-auto mb-5">
        <h2 class="fw-bold mb-2">Why Choose LearnPulse LMS?</h2>
        <p class="text-muted">Designed from the ground up with clean architecture, enterprise security, and seamless user experiences.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-custom h-100 p-4">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 d-inline-block mb-3" style="width: 54px;">
                    <i class="fa-solid fa-circle-play fa-xl"></i>
                </div>
                <h5 class="fw-bold">Interactive Video Lessons</h5>
                <p class="text-muted small mb-0">High-definition video playback with automated progress tracking, bookmarking, and notes.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom h-100 p-4">
                <div class="rounded-3 bg-success-subtle text-success p-3 d-inline-block mb-3" style="width: 54px;">
                    <i class="fa-solid fa-list-check fa-xl"></i>
                </div>
                <h5 class="fw-bold">Quizzes & Assignments</h5>
                <p class="text-muted small mb-0">Automated MCQ grading, timed quizzes, instructor feedback, and assignment file submissions.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom h-100 p-4">
                <div class="rounded-3 bg-info-subtle text-info p-3 d-inline-block mb-3" style="width: 54px;">
                    <i class="fa-solid fa-certificate fa-xl"></i>
                </div>
                <h5 class="fw-bold">Verified Certificates</h5>
                <p class="text-muted small mb-0">Instant PDF certificate generation with embedded QR codes for instant online verification.</p>
            </div>
        </div>
    </div>
</section>
