@using Microsoft.AspNetCore.Identity
@using LMS.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var userRoles = await UserManager.GetRolesAsync(user!);
    var primaryRole = userRoles.FirstOrDefault() ?? "User";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
            {
                <img src="@user.ProfilePictureUrl" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" alt="Avatar" />
            }
            else
            {
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.9rem;">
                    @(user?.FirstName?.FirstOrDefault())@(user?.LastName?.FirstOrDefault())
                </div>
            }
            <div class="d-none d-lg-flex flex-column text-start">
                <span class="fw-bold fs-7 lh-1">@user?.FullName</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mt-1" style="font-size: 0.65rem;">@primaryRole</span>
            </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userDropdown">
            <li class="px-3 py-2 border-bottom d-lg-none">
                <div class="fw-bold">@user?.FullName</div>
                <div class="text-muted small">@user?.Email</div>
                <span class="badge bg-primary text-white mt-1">@primaryRole</span>
            </li>
            
            @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-gauge-high text-primary me-2"></i> Admin Dashboard
                    </a>
                </li>
            }
            else if (User.IsInRole("Instructor"))
            {
                <li>
                    <a class="dropdown-item py-2" asp-area="Instructor" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-chalkboard-user text-success me-2"></i> Instructor Dashboard
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="dropdown-item py-2" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-laptop-code text-info me-2"></i> Student Dashboard
                    </a>
                </li>
            }

            <li>
                <a class="dropdown-item py-2" asp-area="" asp-controller="Account" asp-action="Profile">
                    <i class="fa-solid fa-user text-secondary me-2"></i> My Profile
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger py-2">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-outline-custom me-2" asp-area="" asp-controller="Account" asp-action="Login">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Log In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary-custom" asp-area="" asp-controller="Account" asp-action="Register">
            <i class="fa-solid fa-user-plus me-1"></i> Register
        </a>
    </li>
}
</ul>
