@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card card-custom p-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle mb-4 mx-auto" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-triangle-exclamation fa-2xl"></i>
            </div>
            <h1 class="display-6 fw-bold text-dark mb-2">Access Denied</h1>
            <p class="text-muted lead mb-4">You do not have permission to access this resource or area.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                    <i class="fa-solid fa-house me-2"></i> Return to Safety (Home)
                </a>
            </div>
        </div>
    </div>
</div>
