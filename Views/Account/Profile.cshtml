@model LMS.Web.ViewModels.Account.UserProfileViewModel

@{
    ViewData["Title"] = "User Profile";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-10">
        <div class="row g-4">
            <!-- Left Sidebar Card -->
            <div class="col-12 col-md-4">
                <div class="card card-custom p-4 text-center">
                    <div class="position-relative d-inline-block mx-auto mb-3">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" class="rounded-circle img-thumbnail shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm mx-auto" style="width: 120px; height: 120px; font-size: 2.5rem;">
                                @Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()
                            </div>
                        }
                    </div>

                    <h4 class="fw-bold mb-1">@Model.FullName</h4>
                    <p class="text-muted small mb-2">@Model.Email</p>
                    
                    @if (!string.IsNullOrEmpty(Model.Designation))
                    {
                        <div class="badge bg-secondary-subtle text-secondary px-3 py-1.5 mb-3">@Model.Designation</div>
                    }

                    <div class="d-flex justify-content-center gap-1 mb-3">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary px-2.5 py-1">@role</span>
                        }
                    </div>

                    <hr class="my-3" />
                    
                    <div class="text-start small text-muted">
                        <div class="mb-2">
                            <i class="fa-regular fa-calendar-check me-2 text-primary"></i> Joined @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Main Profile Tabs -->
            <div class="col-12 col-md-8">
                <div class="card card-custom p-4">
                    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold" id="edit-tab" data-bs-toggle="tab" data-bs-target="#edit" type="button" role="tab">
                                <i class="fa-solid fa-user-pen me-2"></i> Profile Details
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="password-tab" data-bs-toggle="tab" data-bs-target="#password" type="button" role="tab">
                                <i class="fa-solid fa-lock me-2"></i> Security / Password
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="profileTabsContent">
                        <!-- Profile Edit Tab -->
                        <div class="tab-pane fade show active" id="edit" role="tabpanel">
                            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="Email" />

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label asp-for="FirstName" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="FirstName" class="form-control" />
                                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="LastName" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="LastName" class="form-control" />
                                        <span asp-validation-for="LastName" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="+123456789" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Designation" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="Designation" class="form-control" placeholder="e.g. Senior Instructor" />
                                        <span asp-validation-for="Designation" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Bio" class="form-label fw-semibold text-secondary small"></label>
                                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell us a little about yourself..."></textarea>
                                    <span asp-validation-for="Bio" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="AvatarFile" class="form-label fw-semibold text-secondary small"></label>
                                    <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
                                    <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary-custom">
                                        <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Change Password Tab -->
                        <div class="tab-pane fade" id="password" role="tabpanel">
                            <form asp-action="ChangePassword" method="post">
                                <div class="mb-3">
                                    <label asp-for="ChangePassword.OldPassword" class="form-label fw-semibold text-secondary small"></label>
                                    <input asp-for="ChangePassword.OldPassword" class="form-control" placeholder="••••••••" />
                                    <span asp-validation-for="ChangePassword.OldPassword" class="text-danger small"></span>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="ChangePassword.NewPassword" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="ChangePassword.NewPassword" class="form-control" placeholder="••••••••" />
                                        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ChangePassword.ConfirmPassword" class="form-label fw-semibold text-secondary small"></label>
                                        <input asp-for="ChangePassword.ConfirmPassword" class="form-control" placeholder="••••••••" />
                                        <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary-custom">
                                        <i class="fa-solid fa-shield-cat me-2"></i> Update Password
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
