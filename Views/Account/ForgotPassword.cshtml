@model LMS.Web.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    bool messageSent = ViewBag.MessageSent ?? false;
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="fa-solid fa-key fa-xl"></i>
                </div>
                <h2 class="fw-bold text-dark mb-1">Forgot Password?</h2>
                <p class="text-muted small">Enter your email address to receive password reset instructions</p>
            </div>

            @if (messageSent)
            {
                <div class="alert alert-success d-flex align-items-center p-3 mb-4" role="alert">
                    <i class="fa-solid fa-circle-check fa-xl me-3"></i>
                    <div>
                        <strong class="d-block">Reset Link Sent!</strong>
                        <span class="small">If an account matches that email, instructions have been logged/sent.</span>
                    </div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2.5 mb-3">
                    <i class="fa-solid fa-paper-plane me-2"></i> Send Reset Link
                </button>
            </form>

            <div class="text-center mt-3 pt-3 border-top">
                <a asp-action="Login" class="text-secondary fw-semibold text-decoration-none small">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
