@model LMS.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="fa-solid fa-lock fa-xl"></i>
                </div>
                <h2 class="fw-bold text-dark mb-1">Welcome Back</h2>
                <p class="text-muted small">Sign in to continue your learning journey</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary small mb-0"></label>
                        <a asp-action="ForgotPassword" class="text-decoration-none small text-primary fw-semibold">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-key"></i></span>
                        <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-input-label text-secondary small"></label>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2.5 mb-3">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
                </button>
            </form>

            <div class="text-center mt-3 pt-3 border-top">
                <p class="text-muted small mb-0">Don't have an account? 
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">Register Now</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
