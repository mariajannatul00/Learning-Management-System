@model LMS.Web.ViewModels.Student.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">My Student Dashboard</h2>
        <p class="text-muted small mb-0">Track your purchased courses, view course content, and manage course enrollments.</p>
    </div>
    <a asp-controller="Courses" asp-action="Index" asp-area="" class="btn btn-primary-custom">
        <i class="fa-solid fa-magnifying-glass me-1"></i> Browse More Courses
    </a>
</div>

<!-- Stats Counters -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-4 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Enrolled Courses</div>
                    <div class="h2 fw-bold text-dark mb-0">@Model.TotalEnrolledCourses</div>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="fa-solid fa-graduation-cap fa-xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Pending Drop Requests</div>
                    <div class="h2 fw-bold text-dark mb-0">@Model.TotalPendingDropRequests</div>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="fa-solid fa-clock-rotate-left fa-xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Account Status</div>
                    <div class="h2 fw-bold text-success mb-0">Active Student</div>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="fa-solid fa-user-check fa-xl"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Purchased Courses Header -->
<h4 class="fw-bold mb-3"><i class="fa-solid fa-book-open text-primary me-2"></i> Purchased Courses</h4>

@if (!Model.Enrollments.Any())
{
    <div class="card card-custom p-5 text-center my-3">
        <div class="py-4">
            <i class="fa-solid fa-cart-flatbed fa-4x text-muted mb-3 opacity-50"></i>
            <h4 class="fw-bold text-dark mb-2">No Enrolled Courses Yet</h4>
            <p class="text-muted mb-4">You have not purchased or enrolled in any courses yet. Browse our catalog and start learning today!</p>
            <a asp-controller="Courses" asp-action="Index" asp-area="" class="btn btn-primary-custom">
                <i class="fa-solid fa-rocket me-1"></i> Explore Courses Now
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @foreach (var enrollment in Model.Enrollments)
        {
            var course = enrollment.Course;
            if (course == null) continue;

            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 d-flex flex-column overflow-hidden">
                    <div class="position-relative">
                        <img src="@course.ThumbnailUrl" class="card-img-top" alt="@course.Title" style="height: 180px; object-fit: cover;" />
                        <span class="position-absolute top-0 start-0 m-3 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                            <i class="@course.Category?.IconClass me-1"></i> @course.Category?.Name
                        </span>
                        
                        @if (enrollment.DropStatus == "Pending")
                        {
                            <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark border fw-bold px-3 py-2">
                                <i class="fa-solid fa-hourglass-half me-1"></i> Drop Pending
                            </span>
                        }
                        else if (enrollment.DropStatus == "Approved")
                        {
                            <span class="position-absolute top-0 end-0 m-3 badge bg-danger text-white fw-bold px-3 py-2">
                                <i class="fa-solid fa-circle-xmark me-1"></i> Course Dropped
                            </span>
                        }
                    </div>

                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold text-dark mb-2">@course.Title</h5>
                        <p class="text-muted small mb-3 flex-grow-1 text-truncate-2">@course.ShortDescription</p>

                        <div class="small text-muted mb-3 border-top pt-2">
                            <div><i class="fa-regular fa-calendar me-1"></i> Enrolled: @enrollment.EnrolledAt.ToString("MMM dd, yyyy")</div>
                            <div><i class="fa-solid fa-receipt me-1 text-success"></i> Paid: ৳@enrollment.PricePaid.ToString("F2")</div>
                            @if (course.StartDate.HasValue && course.EndDate.HasValue)
                            {
                                <div><i class="fa-regular fa-clock me-1 text-primary"></i> Course Timeline: @course.StartDate.Value.ToString("MMM dd") - @course.EndDate.Value.ToString("MMM dd, yyyy")</div>
                            }
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            @if (enrollment.DropStatus == "Approved")
                            {
                                <button class="btn btn-secondary w-100 disabled py-2" disabled>
                                    <i class="fa-solid fa-ban me-1"></i> Dropped
                                </button>
                            }
                            else
                            {
                                <a asp-action="Learn" asp-route-id="@course.Id" class="btn btn-primary-custom flex-grow-1 py-2 text-center">
                                    <i class="fa-solid fa-circle-play me-1"></i> View Content
                                </a>

                                @if (course.IsEnded)
                                {
                                    <button class="btn btn-outline-secondary py-2 px-3 disabled" disabled title="Course timeline has ended. Drop request closed.">
                                        <i class="fa-solid fa-lock me-1"></i> Ended
                                    </button>
                                }
                                else if (enrollment.DropStatus == "None" || enrollment.DropStatus == "Rejected")
                                {
                                    <button type="button" class="btn btn-outline-danger py-2 px-3" 
                                            onclick="openDropModal(@enrollment.Id, '@course.Title.Replace("'", "\\'")')">
                                        <i class="fa-solid fa-arrow-down-left-and-arrow-up-right-to-center me-1"></i> Drop
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Course Drop Request Modal -->
<div class="modal fade" id="dropModal" tabindex="-1" aria-labelledby="dropModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="RequestDrop" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="dropEnrollmentId" name="enrollmentId" value="" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="dropModalLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> Request Course Drop
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">
                        Are you sure you want to request to drop <strong id="dropCourseTitle" class="text-dark"></strong>? 
                        Your drop request will be submitted to the Admin for approval.
                    </p>

                    <div class="alert alert-warning py-2 small mb-3">
                        <div class="fw-bold mb-1"><i class="fa-solid fa-scale-balanced me-1"></i> Course Drop Refund Rules:</div>
                        <ul class="mb-0 ps-3">
                            <li>10% deduction before course start date</li>
                            <li>25% deduction before 1/4th of course timeline</li>
                            <li>50% deduction before 1/2th of course timeline</li>
                            <li>80% deduction before 3/4th of course timeline</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label for="dropReason" class="form-label fw-semibold small text-secondary">Reason for Dropping Course <span class="text-danger">*</span></label>
                        <textarea id="dropReason" name="reason" class="form-control" rows="3" placeholder="Please state your reason for dropping this course..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Drop Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function openDropModal(enrollmentId, courseTitle) {
            document.getElementById('dropEnrollmentId').value = enrollmentId;
            document.getElementById('dropCourseTitle').innerText = courseTitle;
            var modal = new bootstrap.Modal(document.getElementById('dropModal'));
            modal.show();
        }
    </script>
}
