@model LMS.Web.Models.Course
@{
    ViewData["Title"] = "Edit Course - " + Model.Title;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Course Management
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card card-custom p-4 p-md-5">
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit Course</h3>
            <p class="text-muted small mb-4">Modify course details, pricing, or video content.</p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="InstructorId" />
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small text-secondary">Course Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold small text-secondary">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Level" class="form-label fw-semibold small text-secondary">Skill Level <span class="text-danger">*</span></label>
                        <select asp-for="Level" class="form-select" required>
                            <option value="Beginner">Beginner</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="Advanced">Advanced</option>
                        </select>
                        <span asp-validation-for="Level" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold small text-secondary">Regular Price (৳) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiscountPrice" class="form-label fw-semibold small text-secondary">Discount Price (৳)</label>
                        <input asp-for="DiscountPrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold small text-secondary">Course Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold small text-secondary">Course End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DurationHours" class="form-label fw-semibold small text-secondary">Duration (Hours)</label>
                        <input asp-for="DurationHours" type="number" step="0.5" class="form-control" />
                        <span asp-validation-for="DurationHours" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TotalLectures" class="form-label fw-semibold small text-secondary">Total Lectures</label>
                        <input asp-for="TotalLectures" type="number" class="form-control" />
                        <span asp-validation-for="TotalLectures" class="text-danger small"></span>
                    </div>
                </div>


                <div class="mb-3">
                    <label asp-for="ThumbnailUrl" class="form-label fw-semibold small text-secondary">Thumbnail Image URL <span class="text-danger">*</span></label>
                    <input asp-for="ThumbnailUrl" class="form-control" required />
                    <span asp-validation-for="ThumbnailUrl" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IntroVideoUrl" class="form-label fw-semibold small text-secondary">Introductory Video URL <span class="text-danger">*</span></label>
                    <input asp-for="IntroVideoUrl" class="form-control" required />
                    <span asp-validation-for="IntroVideoUrl" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ShortDescription" class="form-label fw-semibold small text-secondary">Short Description <span class="text-danger">*</span></label>
                    <input asp-for="ShortDescription" class="form-control" required />
                    <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold small text-secondary">Full Detailed Overview & Syllabus <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
