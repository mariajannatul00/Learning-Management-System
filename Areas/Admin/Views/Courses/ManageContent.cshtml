@model LMS.Web.Models.Course
@{
    ViewData["Title"] = "Manage Videos & Curriculum - " + Model.Title;
    var modules = ViewBag.Modules as IEnumerable<LMS.Web.Models.Module> ?? new List<LMS.Web.Models.Module>();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Course List
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
        <i class="fa-solid fa-pen me-1"></i> Edit Course Info
    </a>
</div>

<div class="card card-custom p-4 mb-4">
    <div class="row align-items-center">
        <div class="col-md-2 text-center text-md-start mb-3 mb-md-0">
            <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="img-fluid rounded-3 shadow-sm" style="max-height: 100px; object-fit: cover;" />
        </div>
        <div class="col-md-10">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-1">
                <i class="@Model.Category?.IconClass me-1"></i> @Model.Category?.Name
            </span>
            <h3 class="fw-bold text-dark mb-1">@Model.Title</h3>
            <p class="text-muted small mb-0">@Model.ShortDescription</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Add Module & Add Video Forms -->
    <div class="col-lg-5">
        <!-- Add New Module Card -->
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-folder-plus text-primary me-2"></i> Add New Module</h5>
            <form asp-action="AddModule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Module Title <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control" placeholder="e.g. Module 1: Getting Started" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Order Index</label>
                    <input type="number" name="orderIndex" class="form-control" value="@(modules.Count() + 1)" min="1" />
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Create Module
                </button>
            </form>
        </div>

        <!-- Add Video Lesson Card -->
        <div class="card card-custom p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-video text-success me-2"></i> Add Video Lecture</h5>
            @if (!modules.Any())
            {
                <div class="alert alert-warning small mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Please create at least one module first before adding video lessons.
                </div>
            }
            else
            {
                <form asp-action="AddLesson" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Select Module <span class="text-danger">*</span></label>
                        <select name="moduleId" class="form-select" required>
                            @foreach (var mod in modules)
                            {
                                <option value="@mod.Id">@mod.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Video Lecture Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. 1.1 Introduction to C# & .NET 8" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Video URL (MP4 / Streaming Link) <span class="text-danger">*</span></label>
                        <input type="url" name="videoUrl" class="form-control" placeholder="https://commondatastorage.googleapis.com/..." required />
                        <span class="form-text small">Enter an MP4 video URL or sample stream link.</span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Duration (Mins)</label>
                            <input type="number" name="durationMinutes" class="form-control" value="15" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Order Index</label>
                            <input type="number" name="orderIndex" class="form-control" value="1" min="1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Lesson Summary / Overview</label>
                        <textarea name="contentSummary" class="form-control" rows="2" placeholder="Brief summary of what will be learned..."></textarea>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" name="isFreePreview" value="true" id="isFreePreviewCheck">
                        <label class="form-check-label small fw-semibold text-secondary" for="isFreePreviewCheck">
                            Allow Free Preview (Non-enrolled users can watch)
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill text-white fw-bold">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Add Video Lesson
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Right Column: Current Modules & Video Lessons List -->
    <div class="col-lg-7">
        <div class="card card-custom p-4">
            <h5 class="fw-bold text-dark mb-4"><i class="fa-solid fa-list-check text-primary me-2"></i> Course Curriculum & Videos (@modules.Sum(m => m.Lessons.Count) Videos)</h5>

            @if (!modules.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-film fa-3x mb-3 text-secondary opacity-50"></i>
                    <h6>No curriculum modules added yet.</h6>
                    <p class="small mb-0">Use the form on the left to add modules and upload video lectures.</p>
                </div>
            }
            else
            {
                <div class="accordion" id="adminModulesAccordion">
                    @foreach (var mod in modules)
                    {
                        <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                            <h2 class="accordion-header d-flex align-items-center bg-light px-3 py-1">
                                <button class="accordion-button fw-bold text-dark bg-transparent border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMod_@mod.Id" aria-expanded="true">
                                    <i class="fa-solid fa-folder text-primary me-2"></i> @mod.Title
                                    <span class="badge bg-secondary ms-2 text-white">@mod.Lessons.Count Videos</span>
                                </button>
                                <form asp-action="DeleteModule" method="post" class="ms-auto me-2" onsubmit="return confirm('Delete this module and all its video lessons?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="moduleId" value="@mod.Id" />
                                    <input type="hidden" name="courseId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Delete Module">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </h2>
                            <div id="collapseMod_@mod.Id" class="accordion-collapse collapse show">
                                <div class="accordion-body p-0">
                                    @if (!mod.Lessons.Any())
                                    {
                                        <div class="p-3 text-center text-muted small">
                                            No videos added to this module yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var lesson in mod.Lessons)
                                            {
                                                <li class="list-group-item p-3 d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="fa-solid fa-circle-play text-primary"></i>
                                                            <strong class="text-dark small">@lesson.Title</strong>
                                                            @if (lesson.IsFreePreview)
                                                            {
                                                                <span class="badge bg-info text-dark small">Free Preview</span>
                                                            }
                                                        </div>
                                                        <div class="small text-muted mt-1">
                                                            <i class="fa-regular fa-clock me-1"></i> @lesson.DurationMinutes mins
                                                            <span class="mx-1">•</span>
                                                            <a href="@lesson.VideoUrl" target="_blank" class="text-decoration-none text-primary small">
                                                                <i class="fa-solid fa-link me-1"></i> View Video Stream
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <form asp-action="DeleteLesson" method="post" onsubmit="return confirm('Remove this video lesson?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="lessonId" value="@lesson.Id" />
                                                        <input type="hidden" name="courseId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Delete Video">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
