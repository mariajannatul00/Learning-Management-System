@model IEnumerable<LMS.Web.Models.Course>
@{
    ViewData["Title"] = "Course Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Course Management</h2>
        <p class="text-muted small mb-0">Create new courses, edit course information, and manage published courses.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="fa-solid fa-plus me-1"></i> Add New Course
    </a>
</div>

<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Course Details</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@course.ThumbnailUrl" alt="@course.Title" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 250px;">@course.Title</div>
                                    <div class="small text-muted">
                                        @course.DurationHours hrs | @course.TotalLectures lessons
                                        @if (course.StartDate.HasValue && course.EndDate.HasValue)
                                        {
                                            <span class="ms-1 text-primary">(@course.StartDate.Value.ToString("MMM dd") - @course.EndDate.Value.ToString("MMM dd, yyyy"))</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                <i class="@course.Category?.IconClass me-1"></i> @course.Category?.Name
                            </span>
                        </td>
                        <td>
                            @if (course.DiscountPrice.HasValue)
                            {
                                <span class="fw-bold text-success">৳@course.DiscountPrice.Value.ToString("F2")</span>
                                <small class="text-decoration-line-through text-muted ms-1">৳@course.Price.ToString("F2")</small>
                            }
                            else
                            {
                                <span class="fw-bold text-dark">৳@course.Price.ToString("F2")</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-secondary border">@course.Level</span></td>
                        <td>
                            @if (course.IsEnded)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill"><i class="fa-solid fa-clock-rotate-left me-1"></i> Timeline Ended</span>
                            }
                            else if (course.IsPublished)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill">Draft</span>
                            }
                        </td>

                        <td class="text-end pe-4">
                            <a asp-action="ManageContent" asp-route-id="@course.Id" class="btn btn-sm btn-outline-dark me-1" title="Manage Modules & Videos">
                                <i class="fa-solid fa-video me-1"></i> Add/Manage Videos
                            </a>
                            <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fa-solid fa-pen me-1"></i> Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmCourseDelete(@course.Id, '@course.Title.Replace("'", "\\'")')">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Course Modal -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteCourseId" name="id" value="" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="fa-solid fa-trash-can me-2"></i> Delete Course
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small mb-0">
                        Are you sure you want to delete course <strong id="deleteCourseTitle" class="text-dark"></strong>? 
                        This action will mark the course as deleted.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="fa-solid fa-trash me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmCourseDelete(id, title) {
            document.getElementById('deleteCourseId').value = id;
            document.getElementById('deleteCourseTitle').innerText = title;
            var modal = new bootstrap.Modal(document.getElementById('deleteCourseModal'));
            modal.show();
        }
    </script>
}
