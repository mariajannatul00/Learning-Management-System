@model LMS.Web.Models.ApplicationUser
@{
    ViewData["Title"] = "User Profile - " + Model.Email;
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var enrollments = ViewBag.Enrollments as IEnumerable<LMS.Web.Models.Enrollment> ?? new List<LMS.Web.Models.Enrollment>();
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to User List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card card-custom p-4 text-center">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-3" style="width: 80px; height: 80px; font-size: 1.8rem;">
                @(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.FirstName @Model.LastName</h4>
            <p class="text-muted small mb-2">@Model.Email</p>

            <div class="mb-3">
                @foreach (var role in roles)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 me-1">@role</span>
                }
            </div>

            <hr class="my-3" />

            <div class="text-start small text-muted d-flex flex-column gap-2">
                <div><i class="fa-solid fa-calendar me-2"></i> Registered: @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                <div><i class="fa-solid fa-clock-rotate-left me-2"></i> Last Login: @(Model.LastLoginDate?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</div>
                <div><i class="fa-solid fa-shield me-2"></i> Email Verified: @(Model.EmailConfirmed ? "Yes" : "No")</div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-graduation-cap text-primary me-2"></i> Course Enrollments</h5>

            @if (!enrollments.Any())
            {
                <p class="text-muted mb-0">This user is not currently enrolled in any courses.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course Title</th>
                                <th>Enrolled Date</th>
                                <th>Paid</th>
                                <th>Drop Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in enrollments)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.Course?.Title</td>
                                    <td class="small text-muted">@e.EnrolledAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-success fw-bold">৳@e.PricePaid.ToString("F2")</td>

                                    <td>
                                        @if (e.DropStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Drop Pending</span>
                                        }
                                        else if (e.DropStatus == "Approved")
                                        {
                                            <span class="badge bg-danger">Dropped</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
