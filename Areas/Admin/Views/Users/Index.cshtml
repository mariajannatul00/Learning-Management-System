@model IEnumerable<LMS.Web.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">User Management</h2>
        <p class="text-muted small mb-0">View registered system users, inspect profiles, and manage access.</p>
    </div>
</div>

<!-- Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-end-0 text-muted ps-3">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Search user by name or email..." />
            <button type="submit" class="btn btn-primary-custom px-4">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">User</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                    @(user.FirstName?.FirstOrDefault())@(user.LastName?.FirstOrDefault())
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@user.FirstName @user.LastName</div>
                                    <div class="small text-muted">@user.Designation</div>
                                </div>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.EmailConfirmed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Verified</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Unverified</span>
                            }
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fa-solid fa-eye me-1"></i> Profile
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmUserDelete('@user.Id', '@user.Email')">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete User Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Delete" method="post" id="deleteUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteUserId" name="id" value="" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="fa-solid fa-user-xmark me-2"></i> Confirm User Deletion
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small mb-0">
                        Are you sure you want to delete user <strong id="deleteUserEmail" class="text-dark"></strong>? 
                        This action cannot be undone and will remove user access.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="fa-solid fa-trash me-1"></i> Delete User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmUserDelete(id, email) {
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUserEmail').innerText = email;
            var modal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
            modal.show();
        }
    </script>
}
