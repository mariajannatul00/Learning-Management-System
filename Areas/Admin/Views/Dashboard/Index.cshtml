@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Admin Overview</h2>
        <p class="text-muted small mb-0">System metrics, user management, course catalog control, and student drop approvals.</p>
    </div>
    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold">
        <i class="fa-solid fa-user-shield me-1"></i> Admin Portal
    </span>
</div>

<!-- Stats Counter Grid -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <a asp-controller="Users" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-4 border-start border-primary border-4 hover-lift">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Users</div>
                        <div class="h2 fw-bold text-dark mb-0">@ViewBag.TotalUsers</div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="fa-solid fa-users fa-xl"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Courses" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-4 border-start border-success border-4 hover-lift">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Courses</div>
                        <div class="h2 fw-bold text-dark mb-0">@ViewBag.TotalCourses</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="fa-solid fa-book-open fa-xl"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="DropRequests" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom p-4 border-start border-warning border-4 hover-lift">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Drop Requests</div>
                        <div class="h2 fw-bold text-dark mb-0">@ViewBag.PendingDropRequests</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="fa-solid fa-clock-rotate-left fa-xl"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-4 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Active System Users</div>
                    <div class="h2 fw-bold text-dark mb-0">@ViewBag.TotalActiveUsers</div>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-circle">
                    <i class="fa-solid fa-user-check fa-xl"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Quick Action Links -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="fa-solid fa-users-gear fa-xl"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">User Management</h5>
                    <p class="text-muted small mb-0">View user profiles and delete accounts</p>
                </div>
            </div>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary mt-auto w-100">
                Manage System Users <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="fa-solid fa-book-medical fa-xl"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Course Management</h5>
                    <p class="text-muted small mb-0">Add new courses, edit, and delete</p>
                </div>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-success mt-auto w-100">
                Manage Course Catalog <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="fa-solid fa-user-xmark fa-xl"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Drop Requests</h5>
                    <p class="text-muted small mb-0">Approve or reject student drop requests</p>
                </div>
            </div>
            <a asp-controller="DropRequests" asp-action="Index" class="btn btn-outline-warning mt-auto w-100">
                Review Drop Requests <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
